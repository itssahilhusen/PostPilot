DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Optional Neon Auth URL if using Neon's managed Better Auth domain
# NEON_AUTH_BASE_URL=
REDIS_URL=
GEMINI_API_KEY=
GROQ_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
META_LOGIN_CONFIG_ID=
META_REDIRECT_URI=http://localhost:3001/api/integrations/meta/callback
META_GRAPH_API_VERSION=v27.0
ENCRYPTION_SECRET=
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001
OPENAI_API_KEY=
# Optional API key for Lime Slides photo assets; returned photos include an on-screen Pexels credit.
PEXELS_API_KEY=
# Keep this configurable; a stronger planning model than gpt-4o-mini is recommended for Lime beat quality.
LIME_DIRECTOR_MODEL=gpt-4o-mini
# Optional separate model for the one-call-per-beat visual scene agents.
LIME_SCENE_MODEL=
# Enable only for short preview renders; production renders use medium/CRF 18.
LIME_RENDER_PREVIEW=false
GEMINI_VISION_MODEL=gemini-3.8-flash
DEEPSEEK_API_KEY=
COVERR_API_KEY=
# Optional paid speaker cutout. Only used when the user enables the per-project cutout option.
REPLICATE_API_TOKEN=

# Publishing media: bucket endpoint INCLUDING bucket, public CDN base, region (auto for R2).
# Allow PUT from your web origin in bucket CORS. Public URL must serve uploaded objects.
MEDIA_BUCKET_URL=
MEDIA_PUBLIC_URL=
MEDIA_REGION=
MEDIA_ACCESS_KEY_ID=
MEDIA_SECRET_ACCESS_KEY=

# Optional recurring Auto-Ants run. Set on the worker AND frontend. Cron uses UTC.
AUTO_ANTS_APP_URL=
AUTO_ANTS_SECRET=
AUTO_ANTS_WORKSPACE_ID=
AUTO_ANTS_CRON="0 8 * * *"
AUTO_ANTS_RSS_URL=
AUTO_ANTS_NICHE=

# Threads OAuth callback: /api/integrations/threads/callback on BETTER_AUTH_URL.
THREADS_APP_ID=
THREADS_APP_SECRET=
