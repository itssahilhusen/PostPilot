generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Workspace {
  id          String   @id @default(cuid())
  name        String   @default("My Workspace")
  handle      String   @unique @default("my-workspace")
  timezone    String   @default("Asia/Calcutta")
  plan        String   @default("Pro") // Free, Creator, Pro, Agency
  creditsUsed Int      @default(111)
  creditsMax  Int      @default(500)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  accounts    SocialAccount[]
  posts       Post[]
  brandVoices BrandVoice[]
  ideas       Idea[]
  carousels   Carousel[]
  automations Automation[]
  mediaAssets MediaAsset[]
  competitors Competitor[]
  leads       Lead[]
  personas    Persona[]
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  emailVerified Boolean        @default(false)
  image         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  role          String         @default("OWNER") // OWNER, ADMIN, MEMBER, CLIENT
  workspaceId   String?
  workspace     Workspace?     @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  accounts      Account[]
  sessions      Session[]
  members       Member[]
  invitations   Invitation[]

  @@index([workspaceId])
  @@map("user")
}

model Session {
  id                   String   @id @default(cuid())
  expiresAt            DateTime
  token                String   @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  logo        String?
  createdAt   DateTime     @default(now())
  metadata    String?
  members     Member[]
  invitations Invitation[]

  @@map("organization")
}

model Member {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

model SocialAccount {
  id           String    @id @default(cuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  provider     String    // "x", "linkedin", "instagram", "threads", "tiktok", "facebook", "youtube"
  name         String
  handle       String
  avatar       String?
  status       String    @default("active") // "active", "updating", "sync_failed"
  accessToken  String?
  refreshToken String?
  expiresAt    DateTime?
  metadata     String?   @default("{}") // JSON string for followers, metrics
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  personas     Persona[]

  @@unique([workspaceId, provider, handle])
}

model Post {
  id            String        @id @default(cuid())
  workspaceId   String
  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title         String
  content       String        // Primary post or thread 1 body
  rawThreads    String        @default("[]") // JSON string of thread items
  mediaUrls     String        @default("[]") // JSON string array of media urls
  platforms     String        @default("[\"x\",\"linkedin\"]") // JSON array of platform ids
  status        String        @default("DRAFT") // DRAFT, SCHEDULED, PUBLISHED, FAILED
  scheduledAt   DateTime?
  publishedAt   DateTime?
  failureReason String?
  impressions   Int           @default(0)
  engagements   Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  variants      PostVariant[]

  @@index([workspaceId, status])
  @@index([scheduledAt])
}

model PostVariant {
  id             String    @id @default(cuid())
  postId         String
  post           Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  platform       String    // "x", "linkedin", "threads", "instagram", "tiktok"
  tailoredText   String
  externalPostId String?
  status         String    @default("PENDING") // PENDING, PUBLISHED, FAILED
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())

  @@index([postId])
}

model BrandVoice {
  id             String    @id @default(cuid())
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name           String    @default("Alex Rivers - AI Tech Founder")
  formality      Int       @default(30)
  directness     Int       @default(85)
  humor          Int       @default(45)
  targetAudience String    @default("Founders, creators, and engineers looking to scale.")
  bannedWords    String    @default("delve, tapestry, synergy, revolutionize, unleash")
  isDefault      Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([workspaceId])
}

model Idea {
  id              String    @id @default(cuid())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title           String
  excerpt         String?
  sourceType      String    @default("AI") // "Web", "YouTube", "News", "X Viral", "Reddit"
  viralityScore   Int       @default(95)
  tags            String    @default("[]") // JSON array of tag strings
  convertedPostId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([workspaceId])
}

model Carousel {
  id          String          @id @default(cuid())
  workspaceId String
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title       String
  theme       String          @default("dark") // "dark", "gradient", "minimal"
  sourceUrl   String?
  aspectRatio String          @default("4:5")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  slides      CarouselSlide[]

  @@index([workspaceId])
}

model CarouselSlide {
  id         String   @id @default(cuid())
  carouselId String
  carousel   Carousel @relation(fields: [carouselId], references: [id], onDelete: Cascade)
  order      Int      // 1, 2, 3...
  slideType  String   @default("CONTENT") // "COVER", "PROBLEM", "CONTENT", "COMPARISON", "CLOSING"
  headline   String
  body       String
  tag        String?
  bgGradient String?
  imageUrl   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([carouselId])
}

model Automation {
  id             String          @id @default(cuid())
  workspaceId    String
  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name           String          @default("Lead DM Campaign")
  active         Boolean         @default(true)
  triggerType    String          @default("comment") // "comment", "dm"
  targetPostId   String?
  keywords       String          @default("price, link, guide")
  actionType     String          @default("dm")
  dmContent      String
  buttonLabel    String?         @default("Get the link")
  buttonUrl      String?         @default("https://reerts.in")
  replyVariants  String          @default("[\"Sent you a DM! Check your inbox 😊\"]")
  requireFollow  Boolean         @default(false)
  followGateText String?
  captureEmail   Boolean         @default(false)
  emailGateText  String?
  sentCount      Int             @default(0)
  clicksCount    Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  logs           AutomationLog[]

  @@index([workspaceId])
}

model Lead {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  username    String
  platform    String    @default("instagram")
  email       String?
  followed    Boolean   @default(false)
  status      String    @default("CONTACTED") // "CONTACTED", "CONVERTED", "OPTED_OUT"
  createdAt   DateTime  @default(now())

  @@index([workspaceId])
}

model AutomationLog {
  id           String     @id @default(cuid())
  automationId String
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  username     String
  triggerEvent String
  outcome      String
  createdAt    DateTime   @default(now())

  @@index([automationId])
}

model Competitor {
  id          String           @id @default(cuid())
  workspaceId String
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  platform    String           // "threads", "tiktok", "x"
  handle      String
  name        String
  avatar      String?
  followers   Int              @default(0)
  growthRate  String           @default("+5.4%")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  posts       CompetitorPost[]

  @@index([workspaceId])
}

model CompetitorPost {
  id           String     @id @default(cuid())
  competitorId String
  competitor   Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  content      String
  likes        Int        @default(0)
  replies      Int        @default(0)
  shares       Int        @default(0)
  postedAt     DateTime   @default(now())
  remixed      Boolean    @default(false)

  @@index([competitorId])
}

model MediaAsset {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  url         String
  mimeType    String    @default("image/png")
  sizeBytes   Int       @default(0)
  folder      String    @default("default")
  createdAt   DateTime  @default(now())

  @@index([workspaceId])
}

model Persona {
  id                               String         @id @default(cuid())
  workspaceId                      String
  workspace                        Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  socialAccountId                  String?
  socialAccount                    SocialAccount? @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)
  blogAccountId                    String?

  personaNumber                    Int            @default(0) // 0: Slot A, 1: Slot B
  name                             String         @default("Brand Voice")
  status                           String         @default("active") // "active", "analyzing", "failed"
  analysisMethod                   String         @default("myAccount") // "myAccount", "reference", "load", "aiGenerate"
  analyzedPostsCount               Int            @default(0)
  analyzedAt                       DateTime?      @default(now())
  language                         String         @default("en")
  contentLanguage                  String         @default("en")
  sentenceStructureKeepOriginal     Boolean        @default(false)

  // Structured Voice Analysis Sections
  profileIdentity                  String?        @db.Text
  targetAudience                   String?        @default("{}") // JSON: demographic_profile, follow_motivation, audience_needs, implicit_promise
  hookSetting                      String?        @default("{}") // JSON: top_patterns, hook_tone, notable_techniques, avg_hook_length
  writingStyleAnalysis             String?        @default("{}") // JSON: title_format, sentence_structure, thought_development, ending_signatures, emotional_distance, humor_and_personality
  ctaSetting                       String?        @default("{\"items\":[]}") // JSON: array of { type, instruction, examples }
  referenceLinkSetting             String?        @default("{\"enabled\":false,\"format\":\"\",\"placement_note\":null}") // JSON
  coreTopics                       String?        @default("[]") // JSON: string[]
  topPerformingPatterns            String?        @db.Text
  additionalInstructions           String?        @db.Text

  createdAt                        DateTime       @default(now())
  updatedAt                        DateTime       @updatedAt

  @@index([workspaceId])
  @@index([socialAccountId])
}

model NewsSource {
  id                    String        @id @default(cuid())
  name                  String
  websiteUrl            String        @unique @map("website_url")
  rssUrl                String?       @map("rss_url")
  category              String
  sourceType            String        @default("publication") @map("source_type") // official, publication, research, community
  fetchMethod           String        @default("rss") @map("fetch_method") // rss, api, supported_web_extraction, manual
  isActive              Boolean       @default(true) @map("is_active")
  trustLevel            Int           @default(85) @map("trust_level") // 1-100
  language              String        @default("en")
  healthStatus          String        @default("Working") @map("health_status") // Working, Needs Configuration, Temporarily Unavailable, Unsupported, Disabled
  lastFetchedAt         DateTime?     @map("last_fetched_at")
  lastSuccessfulFetchAt DateTime?     @map("last_successful_fetch_at")
  lastError             String?       @map("last_error") @db.Text
  faviconUrl            String?       @map("favicon_url")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  articles              NewsArticle[]

  @@map("news_sources")
  @@index([category])
  @@index([isActive])
  @@index([healthStatus])
}

model NewsArticle {
  id                 String     @id @default(cuid())
  sourceId           String     @map("source_id")
  source             NewsSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  title              String
  originalUrl        String     @map("original_url")
  canonicalUrl       String     @unique @map("canonical_url")
  author             String?
  publishedAt        DateTime   @map("published_at")
  fetchedAt          DateTime   @default(now()) @map("fetched_at")
  description        String?    @db.Text
  articleContent     String?    @map("article_content") @db.Text
  imageUrl           String?    @map("image_url")
  category           String
  tags               String     @default("[]") // JSON string array
  language           String     @default("en")
  contentHash        String     @unique @map("content_hash")
  importanceScore    Int        @default(50) @map("importance_score") // 1-100
  credibilityScore   Int        @default(80) @map("credibility_score") // 1-100
  verificationStatus String     @default("unverified") @map("verification_status") // verified, unverified, disputed
  processingStatus   String     @default("pending") @map("processing_status") // pending, processed, failed
  aiSummary          String?    @map("ai_summary") @db.Text
  mainEvent          String?    @map("main_event") @db.Text
  announcementType   String?    @map("announcement_type") // product launch, funding, research, acquisition, update, industry development
  extractedEntities  String?    @default("{}") @map("extracted_entities") // JSON string { companies: [], products: [], people: [] }
  potentialConcerns  String?    @map("potential_concerns") @db.Text
  createdAt          DateTime   @default(now()) @map("created_at")

  @@map("news_articles")
  @@index([sourceId])
  @@index([category])
  @@index([publishedAt])
  @@index([importanceScore])
  @@index([processingStatus])
}
